# Providence HTN only. This file is included in nginx's existing http context.
map $http_upgrade $providence_htn_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __HOSTNAME__;

    location ^~ /.well-known/acme-challenge/ {
        root /home/developer/htn/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://__HOSTNAME__$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __HOSTNAME__;

    ssl_certificate /etc/letsencrypt/live/__HOSTNAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HOSTNAME__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    access_log /var/log/nginx/providence-htn.access.log;
    error_log /var/log/nginx/providence-htn.error.log;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:__REMOTE_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $providence_htn_connection_upgrade;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_intercept_errors on;
        error_page 502 504 =503 /providence-gateway-unavailable;
    }

    location = /providence-gateway-unavailable {
        internal;
        default_type application/json;
        add_header Cache-Control no-store always;
        return 503 '{"error":"The Mac coordinator is unavailable. Restore its existing connection."}';
    }
}
