[Unit]
Description=Providence account service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=providence-web
Group=providence-web
WorkingDirectory=__RELEASE__/coordinator
Environment=PATH=__NODE_BIN__:/usr/bin:/bin
Environment=PROVIDENCE_PUBLIC_ORIGIN=https://providence.hani.so
Environment=PROVIDENCE_HOSTED_DATA_DIR=/var/lib/providence-web
Environment=PROVIDENCE_ACCOUNT_KEY_FILE=/var/lib/providence-web/account-encryption.key
Environment=PORT=8788
ExecStart=__NODE_BIN__/node --import tsx src/hosted/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/providence-web
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
