# Providence HTN only. Initial ACME challenge route; no existing site is modified.
server {
    listen 80;
    listen [::]:80;
    server_name __HOSTNAME__;

    location ^~ /.well-known/acme-challenge/ {
        root /home/developer/htn/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        default_type application/json;
        return 503 '{"error":"Providence HTTPS gateway is being configured."}';
    }
}
