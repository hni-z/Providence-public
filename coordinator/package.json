{
  "name": "providence-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "tsx src/setup.ts",
    "start": "tsx src/server.ts",
    "device": "tsx src/device.ts",
    "demo:fixture": "tsx scripts/demo-fixture.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts src/desktop/*.test.ts",
    "test:watch-pairing": "node --test ../watch-pairing/issue-code.test.mjs",
    "test:supervisor": "python3 scripts/test-providence-tunnel-supervisor.py",
    "smoke": "tsx src/smoke.ts",
    "smoke:remote": "tsx src/remote-smoke.ts",
    "ask": "tsx src/ask.ts",
    "build:web": "npm --prefix web run build",
    "hosted": "tsx src/hosted/server.ts",
    "connect": "node scripts/connect.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "^0.2.11",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
